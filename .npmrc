# Supply-chain hardening (see AGENTS.md).

# New dependencies are saved as exact versions, never ^/~ ranges.
save-exact=true

# Deliberately no `min-release-age`: the release-age cooldown is enforced by
# the Dependabot npm cooldown in .github/dependabot.yml. A resolver-level
# cooldown has no security-update exception and would block Dependabot's
# automated security fixes.

audit=true
fund=false
